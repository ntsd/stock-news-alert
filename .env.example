# Required Core Secrets (Only 2 keys needed for web sentinel!)
FINNHUB_API_KEY=your_finnhub_api_key_here
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional Notification Channels: Telegram Alerts & Voice Memos
# (Omit to run in Dashboard-Only Web Sentinel Mode)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# Optional Settings (Default: 12 US Tech & Hong Kong Leaders)
WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,AMD,TSM,BABA
POLL_INTERVAL_MS=2200
MIN_CONFIDENCE=0.50
# 0 = today's live alerts only; 1–7 = recent history sync and silent Mongo reevaluation.
HISTORY_SYNC_DAYS=7
PORT=3000
ENABLE_HEALTH_SERVER=true
NODE_ENV=production

# Partner Integrations: MongoDB Atlas (Centralized Prediction Cache)
# Free Tier available at mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=zero_market_radar

# Partner Integrations: ElevenLabs (Voice Note Alerts)
# Claim free 3-month Creator tier at hacktoberfest.com/my
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ENABLE_VOICE_ALERTS=true

# Partner Integrations: Sentry Agent Tracing
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
