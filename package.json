{
  "name": "zero-market-radar",
  "version": "1.0.0",
  "description": "Zero Market Radar: Sub-second System 1 AI financial market radar, live dashboard, and voice dispatch engine powered by TypeSafe AI Jev, ElevenLabs, MongoDB Atlas, and Render.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
