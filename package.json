    "typesafe-ai",
    "jev",
    "stock-news",
    "telegram-bot",
    "sentiment-analysis",
    "hacktoberfest",
    "render"
  ],
  "author": "ntsd",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^11.4.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^16.4.7",
    "lightweight-charts": "^5.2.1",
    "mongodb": "^7.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
